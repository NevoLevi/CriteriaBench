{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-fA-F0-9]{64}$"
        }
      },
      "required": ["repository", "tag", "digest"]
    },
    "worker": {
      "type": "object",
      "properties": {
        "replicaCount": {"type": "integer", "const": 1},
        "metricsPort": {"type": "integer", "minimum": 1024, "maximum": 65535}
      },
      "required": ["replicaCount", "metricsPort"]
    },
    "database": {
      "type": "object",
      "properties": {
        "secretKey": {"type": "string", "minLength": 1}
      },
      "required": ["secretKey"]
    }
  }
}
